{
  "name": "solid-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "prepare": "panda codegen",
    "clean": "rm -rf dist styled-system node_modules/.tmp",
    "reinstall": "pnpm clean && rm -rf node_modules && pnpm install",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@solidjs/router": "1.0.0-next.9",
    "@solidjs/web": "2.0.0-beta.25",
    "dexie": "^4.4.4",
    "solid-js": "2.0.0-beta.25"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pandacss/dev": "^1.11.5",
    "@solidjs/testing-library": "1.0.0-beta.2",
    "@types/node": "^24.13.2",
    "eslint": "^10.8.0",
    "eslint-plugin-solid": "^0.14.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "vite": "^8.1.1",
    "vite-plugin-solid": "^3.0.0-next.16",
    "vitest": "^4.1.10"
  }
}
